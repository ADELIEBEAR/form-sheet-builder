{
  "functions": {
    "api/share.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/s/:slug", "destination": "/api/share?slug=:slug" },
    { "source": "/p/:slug", "destination": "/api/share?type=site&slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
